# AI Model Configuration (e.g., qwen2.5-coder:7b, llama3, etc.)
MODEL_NAME="qwen2.5-coder:7b"

# Database Configuration
DB_PATH="data/cdisc_omop.duckdb"
PROCESSED_DIR="data/processed"
VOCAB_DIR="data/omop_vocab"
VOCAB_MANIFEST_PATH="resources/athena_vocabulary_manifest.json"
MAPPING_RULES_PATH="resources/mapping_rules.json"

# LLM Thresholds
CONFIDENCE_THRESHOLD="0.90"

# Final publication provenance (set true only for explicit development runs)
ALLOW_DIRTY_RUN="false"
